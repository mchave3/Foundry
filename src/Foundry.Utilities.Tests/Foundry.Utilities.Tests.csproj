<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifiers></RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="ProcessTestChild\**\*.cs" />
    <ProjectReference Include="ProcessTestChild\ProcessTestChild.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Foundry.Utilities\Foundry.Utilities.csproj" />
  </ItemGroup>
  <Target Name="CopyProcessTestChild" AfterTargets="Build">
    <ItemGroup>
      <_ProcessTestChildArtifacts Include="ProcessTestChild\bin\$(Platform)\$(Configuration)\$(TargetFramework)\ProcessTestChild.*" />
    </ItemGroup>
    <Error Condition="'@(_ProcessTestChildArtifacts)' == ''" Text="ProcessTestChild build output was not found." />
    <Copy SourceFiles="@(_ProcessTestChildArtifacts)" DestinationFolder="$(OutDir)ProcessTestChild" SkipUnchangedFiles="true" />
  </Target>
</Project>
