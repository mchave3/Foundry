<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UseWPF>false</UseWPF>
    <ApplicationIcon></ApplicationIcon>
    <PackageIcon></PackageIcon>
    <RuntimeIdentifiers></RuntimeIdentifiers>
    <!-- Keep the referenced test child's configuration when it is not listed in the solution. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foundry.Core\Foundry.Core.csproj" />
    <ProjectReference Include="..\Foundry.Utilities.Tests\ProcessTestChild\ProcessTestChild.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyProcessTestChild" AfterTargets="Build">
    <ItemGroup>
      <_ProcessTestChildArtifacts Include="..\Foundry.Utilities.Tests\ProcessTestChild\bin\$(Platform)\$(Configuration)\$(TargetFramework)\ProcessTestChild.*" />
    </ItemGroup>
    <Error Condition="'@(_ProcessTestChildArtifacts)' == ''" Text="ProcessTestChild build output was not found." />
    <Copy SourceFiles="@(_ProcessTestChildArtifacts)" DestinationFolder="$(OutDir)ProcessTestChild" SkipUnchangedFiles="true" />
  </Target>

</Project>
